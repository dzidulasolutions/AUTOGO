datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  users       User[] // relation inverse : liste des utilisateurs ayant ce role
  permissions RolePermission[] // relation inverse vers la table de liaison, pas directement vers Permission

  createdAt DateTime @default(now()) // rempli automatiquement a la creation, jamais modifie manuellement
  updatedAt DateTime @updatedAt

  @@map("roles") // convention SQL : snake_case pluriel, alors que le modele Prisma reste en PascalCase singulier
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique // convention "ressource:action", ex: "clients:create" — lisible et filtrable par prefixe
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId]) // cle primaire composite : empeche un doublon role/permission au niveau base de donnees
  @@map("role_permissions")
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  phone    String? @unique
  password String // hash argon2, jamais le mot de passe en clair

  firstName String
  lastName  String

  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)
  phoneVerified Boolean    @default(false)

  verificationCode          String?
  verificationCodeExpiresAt DateTime?

  resetPasswordToken     String?
  resetPasswordExpiresAt DateTime?

  mfaEnabled Boolean @default(false)
  mfaSecret  String?

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  refreshTokens RefreshToken[]

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime? // soft delete : jamais de suppression physique d'un utilisateur
  profile   UserProfile?

  // agence ou branch
  branchId                    String?
  branch                      Branch?             @relation(fields: [branchId], references: [id])
  transactionsPerformed       Transaction[]
  assignedClients             Client[]            @relation("AssignedClients")
  tontineCollectionsValidated TontineCollection[]

  loansRequested Loan[]   @relation("LoanRequestedBy")
  loansApproved  Loan[]   @relation("LoanApprovedBy")
  reports        Report[]

  @@map("users")
}

// informations personnelles de l'utilisateur, stockees dans une table separee pour eviter de surcharger la table principale "users"
model UserProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  address   String?
  city      String?
  country   String?   @default("Togo")
  birthDate DateTime?
  avatarUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_profiles")
}

// 
model RefreshToken {
  id     String @id @default(uuid())
  token  String @unique // le refresh token est lui-meme hashe avant stockage, jamais en clair
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  familyId String // regroupe tous les tokens issus d'une meme session/rotation — cle pour la detection de reutilisation (tache 1.15)
  revoked  Boolean @default(false)

  userAgent String? // navigateur/appareil, pour aider l'utilisateur a reconnaitre ses sessions
  ipAddress String?

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// agences 

enum BranchStatus {
  ACTIVE
  INACTIVE
}

model Branch {
  id      String  @id @default(uuid())
  name    String  @unique
  code    String  @unique // identifiant court, ex: "LOM-01", utile pour les futurs numeros de recu/client
  address String?
  city    String

  status BranchStatus @default(ACTIVE)

  users   User[] // relation inverse : tous les utilisateurs rattaches a cette agence
  clients Client[] // relation inverse : tous les clients rattaches a cette agence

  transactions Transaction[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime? // soft delete, meme regle que partout ailleurs dans ce projet
  savingsAccounts SavingsAccount[]
  tontineCycles   TontineCycle[]

  loanApprovalLimit Decimal  @default(500000) @db.Decimal(15, 2) // plafond a partir duquel Admin doit approuver
  loans             Loan[]
  reports           Report[]

  @@map("branches")
}

// audit logs
enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String? // l'auteur de l'action; nullable pour les actions systeme/anonymes
  action     AuditAction
  resource   String // ex: "User", "Branch"
  resourceId String? // l'id de la ressource affectee, si applicable

  method     String // GET, POST, PATCH, DELETE
  path       String // ex: "/users/abc123"
  statusCode Int? // code retourne, utile pour distinguer succes/echec

  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

//client
model Client {
  id           String @id @default(uuid())
  clientNumber String @unique // ex: "LOM-01-000234"

  firstName String
  lastName  String
  phone     String  @unique
  email     String?

  photoUrl      String?
  idDocumentUrl String?

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  transactions    Transaction[]
  savingsAccounts SavingsAccount[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  assignedAgentId String?
  assignedAgent   User?          @relation("AssignedClients", fields: [assignedAgentId], references: [id])
  tontineCycles   TontineCycle[]
  loans           Loan[]

  @@map("clients")
}

// transactions
enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  TONTINE_COLLECTION
  TONTINE_PAYOUT
}

enum TransactionStatus {
  COMPLETED
  CANCELLED
}

model Transaction {
  id                String @id @default(uuid())
  transactionNumber String @unique // ex: "TXN-000001"

  type   TransactionType
  status TransactionStatus @default(COMPLETED)
  amount Decimal           @db.Decimal(15, 2) // jamais de Float pour de l'argent

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  performedById String // l'utilisateur (agent/caissier) qui a execute l'operation
  performedBy   User   @relation(fields: [performedById], references: [id])

  idempotencyKey String  @unique // evite les doublons en cas de double appel reseau
  description    String?

  receiptUrl String?

  cancelledAt   DateTime?
  cancelledById String?

  createdAt DateTime @default(now())

  savingsAccounts   SavingsAccount[]
  tontineCollection TontineCollection?
  loanSchedules     LoanSchedule[]

  @@index([clientId])
  @@index([branchId, createdAt])
  @@map("transactions")
}

enum SavingsAccountStatus {
  ACTIVE
  CLOSED
}

model SavingsAccount {
  id            String @id @default(uuid())
  accountNumber String @unique

  balance Decimal              @default(0) @db.Decimal(15, 2)
  status  SavingsAccountStatus @default(ACTIVE)

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  closedAt      DateTime?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  transactionId String?

  @@index([clientId])
  @@map("savings_accounts")
}

//tontine

enum TontineCycleStatus {
  ACTIVE
  CLOSED
}

model TontineCycle {
  id          String @id @default(uuid())
  cycleNumber String @unique

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  amountPerCollection Decimal  @db.Decimal(15, 2)
  durationMonths      Int // entre 1 et 12, valide au niveau du DTO
  startDate           DateTime
  endDate             DateTime // calculee automatiquement : startDate + durationMonths

  allowedWeekdays Int[] // 1=lundi ... 7=dimanche

  status         TontineCycleStatus @default(ACTIVE)
  commissionRate Decimal            @default(0.05) @db.Decimal(5, 4)

  collections TontineCollection[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  @@map("tontine_cycles")
}

enum CollectionStatus {
  A_COLLECTER
  COLLECTE
  MANQUE
}

model TontineCollection {
  id String @id @default(uuid())

  cycleId String
  cycle   TontineCycle @relation(fields: [cycleId], references: [id])

  scheduledDate DateTime
  collectedAt   DateTime?

  status CollectionStatus @default(A_COLLECTER)

  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  collectedById String?
  collectedBy   User?   @relation(fields: [collectedById], references: [id])

  createdAt DateTime @default(now())

  @@unique([cycleId, scheduledDate])
  @@map("tontine_collections")
}

// pret

enum LoanStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  DISBURSED
  CLOSED
}

enum LoanFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

model Loan {
  id         String @id @default(uuid())
  loanNumber String @unique

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  principal      Decimal       @db.Decimal(15, 2) // montant emprunte, hors interet
  interestRate   Decimal       @db.Decimal(5, 4) // taux fixe au moment de la demande, fige pour ce pret
  durationMonths Int
  frequency      LoanFrequency

  status LoanStatus @default(DRAFT)

  requestedById String
  requestedBy   User   @relation("LoanRequestedBy", fields: [requestedById], references: [id])

  approvedById    String?
  approvedBy      User?     @relation("LoanApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?

  disbursedAt DateTime?

  schedules       LoanSchedule[]
  allowedWeekdays Int[]          @default([1, 2, 3, 4, 5]) // lundi-vendredi par defaut si non precise
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  closedAt        DateTime?

  @@map("loans")
}

enum LoanScheduleStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model LoanSchedule {
  id String @id @default(uuid())

  loanId String
  loan   Loan   @relation(fields: [loanId], references: [id])

  installmentNumber Int // 1, 2, 3... position dans l'echeancier
  dueDate           DateTime
  amountDue         Decimal  @db.Decimal(15, 2)

  status LoanScheduleStatus @default(PENDING)
  paidAt DateTime?

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  createdAt DateTime @default(now())

  @@unique([loanId, installmentNumber])
  @@map("loan_schedules")
}

//reports

enum ReportStatus {
  PENDING
  READY
  FAILED
}

model Report {
  id            String       @id @default(uuid())
  branchId      String
  branch        Branch       @relation(fields: [branchId], references: [id])
  month         Int
  year          Int
  status        ReportStatus @default(PENDING)
  fileUrl       String?
  requestedById String?
  requestedBy   User?   @relation(fields: [requestedById], references: [id])
  createdAt     DateTime     @default(now())



  @@unique([branchId, month, year])
  @@map("reports")
}
